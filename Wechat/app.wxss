:root {
  /* Palette inspired by Harmony & Flow */
  --bg-app: #f8fafc; /* slate-50 */
  --bg-surface: #ffffff;
  --bg-surface-subtle: #f1f5f9; /* slate-100 */
  --border-subtle: #e2e8f0; /* slate-200 */
  --text-main: #0f172a; /* slate-900 */
  --text-muted: #475569; /* slate-600 */
  --text-faint: #94a3b8; /* slate-400 */
  --primary: #6366f1; /* indigo-500 */
  --primary-strong: #4f46e5; /* indigo-600 */
  --shadow-ring: 0 0 0 1px rgba(15, 23, 42, 0.05);
  --shadow-sm: var(--shadow-ring), 0 1px 2px 0 rgba(15, 23, 42, 0.05);
}

page {
  background: var(--bg-app);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.card-modern {
  background: var(--bg-surface);
  border: 1rpx solid var(--border-subtle);
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-strong) 100%);
  color: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.25);
  transition: all 0.15s ease;
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 10rpx rgba(99, 102, 241, 0.18);
}

.primary-blue {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(59, 130, 246, 0.25);
  transition: all 0.15s ease;
}

.primary-blue:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 10rpx rgba(59, 130, 246, 0.18);
}

.divider {
  height: 1rpx;
  background: var(--border-subtle);
  margin: 16rpx 0;
  opacity: 0.8;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
  width: fit-content;
}

.tag-primary {
  background: rgba(99, 102, 241, 0.12);
  color: #4f46e5;
}

.tag-success {
  background: rgba(16, 185, 129, 0.12);
  color: #0f9f6e;
}

.tag-muted {
  background: rgba(148, 163, 184, 0.15);
  color: #475569;
}
