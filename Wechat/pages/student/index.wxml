<view class="page">
  <view class="tabs">
    <view class="tab" data-tab="info" bindtap="switchTab" wx:class="{{currentTab==='info' ? 'active' : ''}}">作业</view>
    <view class="tab" data-tab="submit" bindtap="switchTab" wx:class="{{currentTab==='submit' ? 'active' : ''}}">提交</view>
    <view class="tab" data-tab="mine" bindtap="switchTab" wx:class="{{currentTab==='mine' ? 'active' : ''}}">我的</view>
  </view>
  <view class="divider"></view>

  <scroll-view class="content" scroll-y wx:if="{{currentTab==='info'}}">
    <view class="section" wx:if="{{sliderItems.length}}">
      <view class="title">即将到期作业</view>
      <swiper class="swiper" autoplay interval="4000" circular indicator-dots indicator-active-color="#6366f1">
        <block wx:for="{{sliderItems}}" wx:key="id">
          <swiper-item>
            <view class="card swiper-card">
              <view class="card-title">{{item.title}}</view>
              <view class="card-sub">课程：{{item.courseTitle || item.courseId}}</view>
              <view class="card-sub">截止：{{item.deadline || '暂无'}}</view>
              <view class="tag tag-primary">待提交</view>
            </view>
          </swiper-item>
        </block>
      </swiper>
    </view>

    <view class="section">
      <view class="title">待提交作业</view>
      <view wx:if="{{loadingAssignments}}" class="muted">加载中...</view>
      <view wx:if="{{!loadingAssignments && assignments.length === 0}}" class="muted">暂无待提交作业</view>
      <view class="assignment-list">
        <block wx:for="{{assignments}}" wx:key="id" wx:for-index="idx">
          <view class="card">
            <view class="card-title">{{item.title}}</view>
            <view class="card-sub">课程：{{item.courseTitle || item.courseId}}</view>
            <view class="card-sub">截止：{{item.deadline || '暂无'}}</view>
          </view>
          <view wx:if="{{idx < assignments.length - 1}}" class="divider"></view>
        </block>
      </view>
    </view>
  </scroll-view>

  <scroll-view class="content" scroll-y wx:if="{{currentTab==='submit'}}">
    <view class="section">
      <view class="title">选择作业</view>
      <view wx:if="{{loadingAssignments}}" class="muted">加载中...</view>
      <view wx:if="{{!loadingAssignments && assignments.length === 0}}" class="muted">暂无可提交的作业</view>
      <picker
        wx:if="{{assignments.length}}"
        mode="selector"
        range="{{assignments}}"
        range-key="title"
        value="{{selectedIndex}}"
        bindchange="onPickerChange"
      >
        <view class="picker">
          当前选择：{{assignments[selectedIndex].title}}（截止：{{assignments[selectedIndex].deadline || '暂无'}}）
        </view>
      </picker>
    </view>

    <view class="section">
      <view class="title">提交内容</view>
      <textarea
        class="textarea"
        placeholder="请输入作业内容"
        value="{{submissionContent}}"
        bindinput="onInput"
      ></textarea>
      <button class="primary primary-blue" bindtap="submitAssignment">提交</button>
    </view>
  </scroll-view>

  <scroll-view class="content" scroll-y wx:if="{{currentTab==='mine'}}">
    <view class="section" wx:if="{{userInfo}}">
        <view class="title">我的信息</view>
        <view class="user-line">账号：{{userInfo.username}}</view>
        <view class="user-line">角色：{{userInfo.role}}</view>
    </view>

    <view class="section">
      <view class="title">我的提交</view>
      <view wx:if="{{loadingSubmissions}}" class="muted">加载中...</view>
      <view wx:if="{{!loadingSubmissions && submissions.length === 0}}" class="muted">暂无提交记录</view>
      <view class="submission-list">
        <block wx:for="{{submissions}}" wx:key="id" wx:for-index="idx">
          <view class="card">
            <view class="card-title">{{item.assignmentTitle}}</view>
            <view class="card-sub">课程：{{item.courseTitle || item.courseId}}</view>
            <view class="card-sub">成绩：{{item.score !== null ? item.score : '未批改'}}</view>
            <view class="card-sub">评语：{{item.score !== null ? (item.comment || '暂无评语') : '待批改'}}</view>
          </view>
          <view wx:if="{{idx < submissions.length - 1}}" class="divider"></view>
        </block>
      </view>
    </view>
  </scroll-view>
</view>
