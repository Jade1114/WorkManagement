.page {
  min-height: 100vh;
  background: var(--bg-app);
  display: flex;
  flex-direction: column;
}

.tabs {
  display: flex;
  gap: 12rpx;
  padding: 24rpx 24rpx 0 24rpx;
  box-sizing: border-box;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 14rpx;
  background: var(--bg-surface);
  color: var(--text-muted);
  border: 1rpx solid var(--border-subtle);
  transition: all 0.15s ease;
}

.tab.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-strong) 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.25);
  border-color: transparent;
}

.content {
  flex: 1;
  padding: 0 24rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.section {
  background: linear-gradient(180deg, var(--bg-surface) 0%, #ffffff 100%);
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-subtle);
  margin-top: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  margin-bottom: 12rpx;
  color: var(--text-main);
}

.muted {
  color: var(--text-muted);
  font-size: 26rpx;
}

.assignment-list,
.submission-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border-subtle);
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  color: var(--text-muted);
}

.swiper {
  height: 220rpx;
}

.swiper-card {
  height: 180rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.picker {
  padding: 20rpx;
  background: var(--bg-surface-subtle);
  border-radius: 14rpx;
  margin: 12rpx 0;
  color: var(--text-main);
  border: 1rpx solid var(--border-subtle);
}

.textarea {
  min-height: 200rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: 14rpx;
  padding: 18rpx;
  box-sizing: border-box;
  margin: 12rpx 0 18rpx;
  background: var(--bg-surface-subtle);
}

.primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-strong) 100%);
  color: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.25);
  transition: all 0.15s ease;
}

.primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 10rpx rgba(99, 102, 241, 0.18);
}

.primary-blue {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(59, 130, 246, 0.25);
  transition: all 0.15s ease;
}

.primary-blue:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 10rpx rgba(59, 130, 246, 0.18);
}
