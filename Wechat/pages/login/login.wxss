.login-page {
  min-height: 100vh;
  background: var(--bg-app);
  padding: 32rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 28rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, var(--bg-surface) 0%, #ffffff 100%);
  border: 1rpx solid var(--border-subtle);
  box-shadow: var(--shadow-sm);
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  margin-bottom: 12rpx;
  color: var(--text-main);
}

.muted {
  color: var(--text-muted);
  font-size: 26rpx;
  margin-bottom: 18rpx;
}

.primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-strong) 100%);
  color: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.25);
  transition: all 0.15s ease;
}

.primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 10rpx rgba(99, 102, 241, 0.18);
}

.form-item {
  margin: 14rpx 0 20rpx;
}

.input {
  width: 100%;
  height: 92rpx;
  border: 1rpx solid transparent;
  border-radius: 14rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--bg-surface-subtle);
  color: var(--text-main);
  transition: all 0.2s cubic-bezier(0.33, 1, 0.68, 1);
}

.input:focus {
  background: #fff;
  border-color: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(99, 102, 241, 0.12);
}
