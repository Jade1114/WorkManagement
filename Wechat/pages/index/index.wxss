.page {
  padding: 32rpx;
  box-sizing: border-box;
  background: var(--bg-app);
  min-height: 100vh;
}

.section {
  background: linear-gradient(180deg, var(--bg-surface) 0%, #ffffff 100%);
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-subtle);
  margin-bottom: 28rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  margin-bottom: 12rpx;
  color: var(--text-main);
}

.muted {
  color: var(--text-muted);
  font-size: 26rpx;
}

.picker {
  padding: 20rpx;
  background: var(--bg-surface-subtle);
  border-radius: 14rpx;
  margin: 12rpx 0;
  color: var(--text-main);
  border: 1rpx solid var(--border-subtle);
}

.assignment-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border-subtle);
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  color: var(--text-muted);
}

.textarea {
  min-height: 200rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: 14rpx;
  padding: 18rpx;
  box-sizing: border-box;
  margin: 12rpx 0 18rpx;
  background: var(--bg-surface-subtle);
}

.primary {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-strong) 100%);
  color: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.25);
  transition: all 0.15s ease;
}

.primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 10rpx rgba(99, 102, 241, 0.18);
}

.user-line {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.submission-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
