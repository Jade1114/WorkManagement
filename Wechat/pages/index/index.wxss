page {
  background: #f5f6fa;
  height: 100vh;
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.muted {
  color: #999;
  font-size: 26rpx;
}

.picker {
  padding: 20rpx;
  background: #f2f3f5;
  border-radius: 12rpx;
  margin: 12rpx 0;
  color: #333;
}

.assignment-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 18rpx;
  border: 1rpx solid #eef0f3;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  color: #666;
}

.textarea {
  min-height: 200rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  margin: 12rpx 0 16rpx;
}

.primary {
  background: #4f8eff;
  color: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
}
