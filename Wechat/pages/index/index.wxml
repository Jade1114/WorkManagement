<scroll-view class="page" scroll-y>
  <view class="section">
    <view class="title">待提交作业</view>
    <view wx:if="{{loading}}" class="muted">加载中...</view>
    <view wx:if="{{!loading && assignments.length === 0}}" class="muted">暂无待提交作业</view>

    <picker wx:if="{{assignments.length}}" mode="selector" range="{{assignments}}" range-key="title" value="{{selectedIndex}}" bindchange="onPickerChange">
      <view class="picker">
        当前选择：{{assignments[selectedIndex].title}}（截止：{{assignments[selectedIndex].deadline || '无'}}）
      </view>
    </picker>

    <view class="assignment-list">
      <block wx:for="{{assignments}}" wx:key="id">
        <view class="card">
          <view class="card-title">{{item.title}}</view>
          <view class="card-sub">课程：{{item.courseTitle || item.courseId}}</view>
          <view class="card-sub">截止：{{item.deadline || '无'}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="title">提交内容</view>
    <textarea class="textarea" placeholder="输入作业内容" value="{{submissionContent}}" bindinput="onInput" />
    <button class="primary" bindtap="submitAssignment">提交</button>
  </view>
</scroll-view>
