<scroll-view class="page" scroll-y>
  <view class="section">
    <view class="title">提交列表</view>
    <view class="muted">作业：{{assignmentTitle || assignmentId}}</view>
    <view wx:if="{{loading}}" class="muted">加载中...</view>
    <view wx:if="{{!loading && submissions.length === 0}}" class="muted">暂无提交</view>
    <view class="submission-list">
      <block wx:for="{{submissions}}" wx:key="id" wx:for-index="idx">
        <view class="card">
          <view class="card-title">学生：{{item.username || item.studentId}}</view>
          <view class="card-sub">内容：{{item.content}}</view>
          <view class="card-sub">状态：{{item.score !== null ? '已批改' : '未批改'}}</view>
          <view class="card-sub">分数：{{item.score !== null ? item.score : '--'}}</view>
          <view class="card-sub">评语：{{item.comment || '暂无'}}</view>
          <view class="btn-row">
            <button
              class="primary primary-blue"
              data-id="{{item.id}}"
              data-username="{{item.username || item.studentId}}"
              data-score="{{item.score}}"
              data-comment="{{item.comment}}"
              bindtap="openGrade"
            >
              批改
            </button>
          </view>
        </view>
        <view wx:if="{{idx < submissions.length - 1}}" class="divider"></view>
      </block>
    </view>
  </view>
</scroll-view>

<view wx:if="{{gradingVisible}}" class="mask">
  <view class="grade-panel">
    <view class="panel-title">批改</view>
    <input class="input" type="number" placeholder="分数" value="{{gradingScore}}" bindinput="onScoreInput" />
    <textarea class="textarea" placeholder="评语（可选）" value="{{gradingComment}}" bindinput="onCommentInput"></textarea>
    <view class="panel-actions">
      <button class="btn ghost" bindtap="closeGrade">取消</button>
      <button class="primary primary-blue" bindtap="submitGrade">提交</button>
    </view>
  </view>
</view>
