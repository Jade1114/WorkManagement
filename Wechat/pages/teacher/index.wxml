<view class="page">
  <view class="tabs">
    <view class="tab" data-tab="home" bindtap="switchTab" wx:class="{{currentTab==='home' ? 'active' : ''}}">首页</view>
    <view class="tab" data-tab="assignments" bindtap="switchTab" wx:class="{{currentTab==='assignments' ? 'active' : ''}}">作业</view>
    <view class="tab" data-tab="profile" bindtap="switchTab" wx:class="{{currentTab==='profile' ? 'active' : ''}}">我的</view>
  </view>

  <scroll-view class="content" scroll-y wx:if="{{currentTab==='home'}}">
    <view class="section">
      <view class="title">数据概览</view>
      <view wx:if="{{loadingStats}}" class="muted">加载中...</view>
      <view wx:if="{{!loadingStats && !stats}}" class="muted">暂无数据</view>
      <view class="stat-row" wx:if="{{stats}}">
        <view class="stat-card">
          <view class="stat-value">{{stats.pendingSubmissions}}</view>
          <view class="stat-label">待批改</view>
        </view>
        <view class="stat-card">
          <view class="stat-value">{{stats.assignments}}</view>
          <view class="stat-label">发布作业</view>
        </view>
        <view class="stat-card">
          <view class="stat-value">{{stats.students}}</view>
          <view class="stat-label">学生数</view>
        </view>
        <view class="stat-card">
          <view class="stat-value">{{stats.courses}}</view>
          <view class="stat-label">课程数</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="title">快速发布</view>
      <button class="primary primary-blue" bindtap="openPublish">发布作业</button>
    </view>
  </scroll-view>

  <scroll-view class="content" scroll-y wx:if="{{currentTab==='assignments'}}">
    <view class="section">
      <view class="title">作业列表</view>
      <view wx:if="{{loadingAssignments}}" class="muted">加载中...</view>
      <view wx:if="{{!loadingAssignments && assignments.length === 0}}" class="muted">暂无作业</view>
      <view class="assignment-list">
        <block wx:for="{{assignments}}" wx:key="id" wx:for-index="idx">
          <view class="card">
            <view class="card-title">{{item.title}}</view>
            <view class="card-sub">课程：{{item.courseTitle || item.courseId}}</view>
            <view class="card-sub">截止：{{item.deadline || '暂无'}}</view>
            <view class="btn-row">
              <button
                class="primary primary-blue"
                data-id="{{item.id}}"
                data-title="{{item.title}}"
                bindtap="goSubmissions"
              >
                批改作业
              </button>
            </view>
          </view>
          <view wx:if="{{idx < assignments.length - 1}}" class="divider"></view>
        </block>
      </view>
    </view>
  </scroll-view>

  <scroll-view class="content" scroll-y wx:if="{{currentTab==='profile'}}">
    <view class="section">
      <view class="title">我的</view>
      <view class="muted">姓名：{{userInfo ? userInfo.username : '—'}}</view>
      <view class="muted">角色：{{userInfo ? userInfo.role : '—'}}</view>
      <view class="muted">ID：{{userInfo ? userInfo.id : '—'}}</view>
    </view>
  </scroll-view>
</view>

<view wx:if="{{publishVisible}}" class="mask">
  <view class="publish-panel">
    <view class="panel-title">发布作业</view>
    <picker
      mode="selector"
      range="{{courses}}"
      range-key="title"
      value="{{publishCourseIndex}}"
      bindchange="onPublishCourseChange"
    >
      <view class="picker">课程：{{courses[publishCourseIndex].title}}</view>
    </picker>
    <input class="input" placeholder="作业名称" value="{{publishTitle}}" bindinput="onPublishTitleInput" />
    <textarea class="textarea" placeholder="作业内容（可选）" value="{{publishContent}}" bindinput="onPublishContentInput"></textarea>
    <input class="input" placeholder="截止时间（可选，格式 yyyy-MM-dd HH:mm:ss）" value="{{publishDeadline}}" bindinput="onPublishDeadlineInput" />
    <view class="panel-actions">
      <button class="btn ghost" bindtap="closePublish">取消</button>
      <button class="primary primary-blue" bindtap="submitPublish">发布</button>
    </view>
  </view>
</view>
