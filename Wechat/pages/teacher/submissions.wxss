.page {
  padding: 32rpx;
  box-sizing: border-box;
  background: var(--bg-app);
  min-height: 100vh;
}

.section {
  background: linear-gradient(180deg, var(--bg-surface) 0%, #ffffff 100%);
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-subtle);
  margin-bottom: 28rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  margin-bottom: 12rpx;
  color: var(--text-main);
}

.muted {
  color: var(--text-muted);
  font-size: 26rpx;
}

.submission-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border-subtle);
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  color: var(--text-muted);
}

.btn-row {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  z-index: 99;
}

.grade-panel {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-subtle);
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 92rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: 14rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  background: #fff;
}

.textarea {
  min-height: 160rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  background: #fff;
}

.panel-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
}

.btn {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-subtle);
  background: #fff;
}

.ghost {
  color: var(--text-muted);
}
