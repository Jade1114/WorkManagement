.page {
  min-height: 100vh;
  background: var(--bg-app);
  display: flex;
  flex-direction: column;
}

.tabs {
  display: flex;
  gap: 12rpx;
  padding: 24rpx 24rpx 0 24rpx;
  box-sizing: border-box;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 14rpx;
  background: var(--bg-surface);
  color: var(--text-muted);
  border: 1rpx solid var(--border-subtle);
  transition: all 0.15s ease;
}

.tab.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-strong) 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.25);
  border-color: transparent;
}

.content {
  flex: 1;
  padding: 0 24rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.section {
  background: linear-gradient(180deg, var(--bg-surface) 0%, #ffffff 100%);
  border-radius: 18rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-subtle);
  margin-top: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  margin-bottom: 12rpx;
  color: var(--text-main);
}

.muted {
  color: var(--text-muted);
  font-size: 26rpx;
}

.stat-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.stat-card {
  flex: 1;
  background: var(--bg-surface-subtle);
  border: 1rpx solid var(--border-subtle);
  border-radius: 14rpx;
  padding: 16rpx;
  box-shadow: var(--shadow-sm);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.assignment-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border-subtle);
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  color: var(--text-muted);
}

.btn-row {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  z-index: 99;
}

.publish-panel {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-subtle);
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.picker {
  padding: 20rpx;
  background: var(--bg-surface-subtle);
  border-radius: 14rpx;
  margin: 12rpx 0;
  color: var(--text-main);
  border: 1rpx solid var(--border-subtle);
}

.input {
  width: 100%;
  height: 92rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: 14rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  background: #fff;
}

.textarea {
  min-height: 160rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  background: #fff;
}

.panel-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
}

.btn {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-subtle);
  background: #fff;
}

.ghost {
  color: var(--text-muted);
}
